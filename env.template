# Environment Variables Template for Swift-Ship Backend
# Copy this file to .env and fill in your actual values

# MySQL Database Configuration (for phpMyAdmin/cPanel)
DB_HOST=localhost
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# Server Configuration
PORT=5000

# Email Configuration
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# JWT Configuration
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_here

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# LocationIQ API
LOCATIONIQ_API_KEY=your_locationiq_api_key

# Google OAuth (if used)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend URL (for CORS)
# Backend API: citymovers.com.ph/api
# Frontend: citymovers.com.ph/adm
PRODUCTION_FRONTEND_URL=http://citymovers.com.ph/adm

# Firebase Configuration (if used)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY=your-firebase-private-key

